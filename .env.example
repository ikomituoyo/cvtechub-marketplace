# Copy this file to .env.local and fill in real values before running.

# Random long string used to sign auth JWTs. Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# Paystack keys — get these from your Paystack dashboard (Settings > API Keys & Webhooks).
# Use test keys (pk_test_/sk_test_) until you're ready to go live.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me

# SQLite file path (fine for local dev/demo). For production, see README for swapping to Postgres.
DATABASE_FILE=./data/cvtechub.db
